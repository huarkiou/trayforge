# Maintainer: <your-name> <your-email>
# Contributor: <your-name> <your-email>
# AUR submission: upload this PKGBUILD + trayforge.install to AUR
# Before submitting: update pkgver, run `updpkgsums` to generate sha256sums

pkgname=trayforge-bin
pkgver=1.0.0
pkgrel=1
pkgdesc="Cross-platform system tray process manager for NapCat QQ, AstrBot, llama.cpp"
arch=('x86_64')
url="https://github.com/huarkiou/TrayForge"
license=('MIT')
options=(!debug)
install=trayforge.install
depends=('libayatana-appindicator')

# Download pre-built binary + icon from GitHub release
source=(
  "$pkgname-$pkgver::https://github.com/huarkiou/TrayForge/releases/download/v$pkgver/TrayForge"
  "trayforge.png::https://github.com/huarkiou/TrayForge/releases/download/v$pkgver/trayforge.png"
)
sha256sums=('SKIP' 'SKIP')

package() {
  install -Dm755 "$srcdir/$pkgname-$pkgver" "$pkgdir/usr/bin/trayforge"
  install -Dm644 "$srcdir/trayforge.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/trayforge.png"

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/trayforge.desktop" << 'EOF'
[Desktop Entry]
Type=Application
Name=TrayForge
Comment=System tray process manager
Exec=trayforge
Icon=trayforge
Terminal=false
Categories=Utility;
EOF
}
